<?xml version="1.0"?>
<ruleset name="Infrangible">
    <description>Magento 2 coding standard and PHP 8.2+ compatibility for Infrangible modules</description>

    <file>src</file>

    <arg name="extensions" value="php,phtml,xml"/>
    <arg value="s"/>

    <rule ref="Magento2"/>

    <!-- the root elements of Magento XML files (schema locations) are longer than 120 characters, as in Magento itself -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*.xml</exclude-pattern>
    </rule>

    <rule ref="PHPCompatibility"/>
    <config name="testVersion" value="8.2-"/>
</ruleset>
