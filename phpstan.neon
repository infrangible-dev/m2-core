# Run in the cli container of the Anodosys system:
#   cd /var/www/magento && vendor/bin/phpstan analyse -c /var/www/module/phpstan.neon
# In another Magento installation, set MAGENTO_ROOT, for example:
#   MAGENTO_ROOT=/path/to/magento /path/to/magento/vendor/bin/phpstan analyse -c phpstan.neon
parameters:
    level: 9
    paths:
        - src
    bootstrapFiles:
        # generates factories and extension attributes on the fly, as in Magento's own static tests
        - phpstan.bootstrap.php
    # @throws tags as PhpStorm expects them: every checked exception that a method lets through has to be declared,
    # and not more than that; unchecked are the same exceptions as in the PhpStorm settings of the modules
    exceptions:
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        uncheckedExceptionClasses:
            - Error
            - LogicException
            - RuntimeException
            # PHPUnit declares interfaces like PHPUnit\Framework\MockObject\Exception in @throws of createMock()
            - PHPUnit\Exception
            # thrown by Magento\Framework\DB\Select for invalid parts of a query, a programming error
            - Zend_Db_Select_Exception
    ignoreErrors:
        # the tests use attributes of newer PHPUnit versions (DataProvider: 10+, AllowMockObjectsWithoutExpectations:
        # 12.5+), which older versions ignore; Magento 2.4.6 comes with PHPUnit 9
        -
            message: '#^Attribute class PHPUnit\\Framework\\Attributes\\(DataProvider|AllowMockObjectsWithoutExpectations) does not exist\.$#'
            reportUnmatched: false
